{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "An individual Ultradian focus or break session recorded by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" },
        "dateString": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "actualSecondsCompleted": { "type": "number" },
        "type": { "type": "string" },
        "presetName": { "type": "string" },
        "category": { "type": "string" },
        "taskName": { "type": "string" },
        "focusRating": { "type": "number" },
        "energyLevelBefore": { "type": "number" },
        "energyLevelAfter": { "type": "number" },
        "distractionsCount": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "timestamp", "durationMinutes", "actualSecondsCompleted", "type", "category", "taskName"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Lifetime aggregated stats for a user on the global leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "lifetimeHours": { "type": "number" },
        "lifetimeCycles": { "type": "number" },
        "currentWeek": { "type": "string" },
        "leagueId": { "type": "string" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["userId", "name"]
    },
    "WeeklyLeaderboardEntry": {
      "title": "WeeklyLeaderboardEntry",
      "description": "Time-boxed weekly stats for a user on the leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "weeklyHours": { "type": "number" },
        "completedCycles": { "type": "number" },
        "focusScore": { "type": "number" },
        "topCategory": { "type": "string" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["userId", "name", "weeklyHours", "completedCycles", "focusScore"]
    },
    "LeagueMember": {
      "title": "LeagueMember",
      "description": "A user's ranking inside a specific matchmaking league.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "weeklyHours": { "type": "number" },
        "completedCycles": { "type": "number" },
        "focusScore": { "type": "number" },
        "leagueId": { "type": "string" },
        "rank": { "type": "number" }
      },
      "required": ["userId", "name", "weeklyHours", "leagueId"]
    }
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "User focus sessions subcollection."
    },
    "/leaderboard/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Global lifetime leaderboard entries."
    },
    "/leaderboard/{userId}/weeks/{weekId}": {
      "schema": "WeeklyLeaderboardEntry",
      "description": "Time-boxed weekly stats for zero-reset leaderboards."
    },
    "/leagues/{leagueId}/members/{userId}": {
      "schema": "LeagueMember",
      "description": "League membership and rankings."
    }
  }
}
