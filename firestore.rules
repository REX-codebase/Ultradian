rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }
    function isValidSessionData() {
      let data = request.resource.data;
      return data.userId == request.auth.uid
        && data.durationMinutes is number
        && data.durationMinutes >= 1
        && data.durationMinutes <= 180
        && (!('focusRating' in data) || (data.focusRating is number && data.focusRating >= 1 && data.focusRating <= 5))
        && (!('actualSecondsCompleted' in data) || (data.actualSecondsCompleted is number && data.actualSecondsCompleted >= 0 && data.actualSecondsCompleted <= 10800))
        && (!('type' in data) || data.type in ['work', 'shortBreak', 'longBreak'])
        && (!('category' in data) || isValidString(data.category, 40));
    }
    
    // User Profiles — owner-only reads to prevent PII (email) harvesting
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      
      // Sessions (Subcollection - Immutable Event Log)
      // Strict schema validation prevents leaderboard spoofing via inflated durationMinutes
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSessionData();
        allow update, delete: if false; // Sessions are immutable focus events
      }
    }
    
    // Global Leaderboard & Subcollections (Zero client writes, public read)
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if false; // Only Admin SDK via Cloud Functions
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    // Leagues (Zero client writes, public read)
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if false; 
      match /members/{memberId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    // Tribes are public read-only projections. Their membership and aggregate
    // fields must be maintained by trusted server workflows, never the client.
    match /tribes/{tribeId} {
      allow read: if true;
      allow write: if false;
    }
    
    // VIP rate-limit documents (server-only writes)
    match /vipRateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
