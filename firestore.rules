rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollection for sessions
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Leaderboard is globally readable, but writable only by the owner or simulated competitors
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || userId.startsWith('friend_'));
    }

    // Allow public read for test connection documents
    match /test/{docId} {
      allow read: if true;
    }
  }
}
